VITE_API_URL=/api
VITE_BASE_PATH=/

# Canonical public base URL for share links / og:url (see .env.production).
# Intentionally left unset here: in local dev we WANT share/copy-link URLs to
# fall back to window.location (whatever host:port you're actually browsing
# on) so links you test locally are reachable from this machine.
VITE_PUBLIC_BASE_URL=
