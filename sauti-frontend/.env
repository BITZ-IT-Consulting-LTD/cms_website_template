VITE_BASE_PATH=/

# Canonical public base URL used to build share links (Facebook/X/WhatsApp/etc.)
# and absolute og:url values. Left empty here so window.location is used as a
# fallback; set a real value in .env.production so shared links never point at
# a raw dev host/IP. See .env.production for the production value.
VITE_PUBLIC_BASE_URL=