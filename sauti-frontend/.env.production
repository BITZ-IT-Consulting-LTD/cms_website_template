VITE_BASE_PATH=/sauti/
VITE_API_URL=/sauti/api

# Canonical public base URL (scheme + host + base path, no trailing slash).
# Article/resource share links and og:url are built from this instead of
# window.location.href, so a link shared from a dev IP or internal hostname
# still resolves to the real public site for the recipient.
VITE_PUBLIC_BASE_URL=https://sauti.mglsd.go.ug/sauti
