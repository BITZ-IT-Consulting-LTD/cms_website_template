VITE_API_BASE_URL=/api
VITE_BASE_PATH=/admin/

# Public site base URL, used by the Blog Preview modal to load a post's real
# page in an iframe. Was never set anywhere in this repo, so the modal fell
# back to a hardcoded 'http://localhost:3000' -- nothing in this project runs
# on that port, so the preview never actually loaded the real page.
VITE_FRONTEND_URL=http://localhost:5173
